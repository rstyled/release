#!/usr/bin/env bash
# Prints the version of the commit checked out, as key=value lines for GITHUB_OUTPUT:
#   version   X.Y.Z: the release this commit is, or makes, or else the latest release before it
#   tag       vX.Y.Z
#   release   true when this commit makes a new release (a feat, fix, perf or breaking commit since the last tag, or
#             no tag yet): publishing it should tag it
#   tagged    true when this commit is the release `version` names, made now or already
#   describe  the build's version: `version` when tagged, else `git describe`'s X.Y.Z-N-gSHA
# INITIAL_VERSION (default 0.0.1) is the first release of a repository with no vX.Y.Z tag.
# It needs the full history and tags: check out with fetch-depth 0.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
initial=${INITIAL_VERSION:-0.0.1}
match='v[0-9]*.[0-9]*.[0-9]*'
semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'

if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
  echo "the checkout is shallow: knope reads every commit since the last release, so check out with fetch-depth: 0" >&2
  exit 1
fi

if exact=$(git describe --tags --exact-match --match "$match" HEAD 2>/dev/null); then
  version=${exact#v} release=false tagged=true
elif ! last=$(git describe --tags --abbrev=0 --match "$match" HEAD 2>/dev/null); then
  version=$initial release=true tagged=true
else
  version=$("$here/knope" next-version | tail -n 1)
  if [ "v$version" = "$last" ]; then
    release=false tagged=false
  else
    release=true tagged=true
  fi
fi

if ! [[ $version =~ $semver ]]; then
  echo "not a release version: '$version'" >&2
  exit 1
fi

if [ "$tagged" = true ]; then
  describe=$version
else
  describe=$(git describe --tags --abbrev=12 --match "$match" HEAD)
  describe=${describe#v}
fi

printf 'version=%s\ntag=v%s\nrelease=%s\ntagged=%s\ndescribe=%s\n' "$version" "$version" "$release" "$tagged" "$describe"
